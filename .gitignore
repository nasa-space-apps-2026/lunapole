# --- secrets: never commit ---
.env
.env.*
*.pem
*.key
*_rsa
id_rsa*

# --- large data: public domain, re-downloadable, too big for git ---
# DE ephemeris kernels (~33-114 MB) — download via scripts/fetch_data.sh
*.bsp
*.bpc
*.tls
*.tsc
# SPICE text kernels — pck00010.tpc is 124 KB, not worth versioning;
# fetch_data.sh pulls it alongside the rest.
*.tpc
*.pck

# --- DEM rasters: multi-GB, re-croppable from source ---
data/raw/
data/**/*.tif
data/**/*.img
# PDS/LOLA rasters ship as IMG and JPEG 2000; the .jp2s are 34-185 MB each
data/dem/
data/**/*.jp2
data/**/*.lbl
data/**/*.xml
artifacts/dem/
*.h5
*.nc

# --- baked artifacts: regenerate with `python build/lunapole/bake.py`, deterministic ---
artifacts/ephemeris/
artifacts/horizon/
artifacts/maps/
artifacts/manifest.json
artifacts/.stage-*/
artifacts/.check-*/

# --- app build products: regenerate with `python scripts/build_app.py` ---
app/data/terrain/
app/dist/

# --- demo recording: large; keep a copy on the demo laptop, not in git ---
docs/demo-fallback.mp4

# --- agent transcript exports: local scratch, not project content ---
20??-??-??-??????-*.txt

# --- python ---
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# --- node ---
node_modules/
dist/
.vite/
*.tsbuildinfo

# --- editors / OS ---
.vscode/
.idea/
.DS_Store
*.swp