# --- secrets: never commit ---
.env
.env.*
*.pem
*.key
*_rsa
id_rsa*

# --- large data: public domain, re-downloadable, too big for git ---
# DE ephemeris kernels (~33-114 MB) — download via scripts/fetch_data.sh
*.bsp
*.bpc
*.tls
*.tsc
# SPICE text kernels — pck00010.tpc is 124 KB, not worth versioning;
# fetch_data.sh pulls it alongside the rest.
*.tpc
*.pck

# --- DEM rasters: multi-GB, re-croppable from source ---
data/raw/
data/**/*.tif
data/**/*.img
artifacts/dem/
*.h5
*.nc

# --- baked artifacts: regenerate with `python build/bake.py`, deterministic ---
artifacts/ephemeris/
artifacts/horizon/
artifacts/maps/

# --- python ---
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# --- node ---
node_modules/
dist/
.vite/
*.tsbuildinfo

# --- editors / OS ---
.vscode/
.idea/
.DS_Store
*.swp